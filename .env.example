PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017/pastperfect
WEB_ORIGIN=http://localhost:3000
# local is for development only; production requires cloudinary and real credentials.
IMAGE_DRIVER=local
UPLOAD_DIR=./uploads
# PLACEHOLDERS: replace securely before setting IMAGE_DRIVER=cloudinary.
CLOUDINARY_CLOUD_NAME=REPLACE_WITH_ACCOUNT_NAME
CLOUDINARY_APIKEY=REPLACE_WITH_API_KEY
CLOUDINARY_APISECRET=REPLACE_WITH_API_SECRET
# Set NODE_ENV=production only with HTTPS and configured Cloudinary.

# Optional JSON catalogue override (absolute path recommended). Bundled geography is placeholder-only.
# CATALOGUE_FILE=/absolute/path/to/catalogue.json

# Operator-managed admin allowlist; replace with comma-separated existing User ObjectIds.
# Invalid/placeholder IDs grant no access. Never accept admin roles from client input.
ADMIN_USER_IDS=REPLACE_WITH_ADMIN_USER_IDS
# Starter retention choice only; review your policy before applying cleanup.
MEDIA_RETENTION_DAYS=30

# Local development: private, ignored email files. Never serve this directory over HTTP.
MAIL_DRIVER=local
MAIL_OUTBOX_DIR=.mail-outbox
# Production: set MAIL_DRIVER=smtp and replace all placeholders securely.
SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_FROM=REPLACE_WITH_FROM_ADDRESS

# Optional reviewed JSON policy override. Bundled rules are explicit placeholders.
# POLICY_FILE=/absolute/path/to/policy.json

# Starter grace period for conservative local orphan inspection; review operational policy.
MEDIA_ORPHAN_GRACE_HOURS=24
